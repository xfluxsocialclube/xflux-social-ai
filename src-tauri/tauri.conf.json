{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "XFLUX Social AI",
  "version": "0.5.0",
  "identifier": "com.xflux.socialai",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "XFLUX Social AI",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 620,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "category": "SocialNetworking",
    "shortDescription": "Planejamento e organização de conteúdo para redes sociais",
    "longDescription": "Organize mídias, legendas, calendário editorial e publicações assistidas com o XFLUX Social AI.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
