# Copie para .env apenas no servidor; nunca versione valores reais.
# Sessão anônima por instalação: o servidor assina sessões curtas; gere uma chave aleatória forte e mantenha-a somente no servidor.
XFLUX_ENV=development
XFLUX_DEVICE_SESSION_SECRET=replace-with-a-random-secret-of-at-least-32-characters
# Compatibilidade para testes/desenvolvimento legado; não é enviado ao aplicativo.
XFLUX_JWT_SECRET=replace-with-at-least-32-random-characters
XFLUX_JWT_ISSUER=https://identity.example.invalid
XFLUX_JWT_AUDIENCE=xflux-api
XFLUX_JWKS_URL=
XFLUX_DATABASE_PATH=/data/xflux.sqlite3
XFLUX_ALLOWED_ORIGINS=http://localhost:1420,tauri://localhost

# Meta OAuth: deixe vazio até configurar o aplicativo oficial e callback HTTPS.
META_APP_ID=
META_APP_SECRET=
META_OAUTH_REDIRECT_URI=
META_GRAPH_VERSION=v25.0
XFLUX_TOKEN_ENCRYPTION_KEY=
